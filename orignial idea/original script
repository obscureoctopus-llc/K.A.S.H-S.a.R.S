 * ─────────────────────────────────────────────────────────────────────────────
 * OVERVIEW
 * ─────────────────────────────────────────────────────────────────────────────
 * Reads target-presence data (distance, angle, speed, energy) from a 24 GHz
 * FMCW radar module over UART and forwards the parsed packet to a paired
 * ESP32-based handheld display (CYD) via the ESP-NOW protocol.
 *
 * HARDWARE
 *   • Seeed Studio XIAO ESP32-C6          — main MCU / ESP-NOW transmitter
 *   • 24 GHz FMCW radar module            — connected on UART1
 *   • CYD (Cheap Yellow Display) ESP32    — wireless receiver / display
 *
 * DEPENDENCIES (install via Arduino Library Manager)
 *   • ESP32 Arduino core ≥ 3.x (espressif/arduino-esp32)
 *     (esp_now.h and WiFi.h are bundled — no separate install needed)
 *
 * BEFORE FLASHING
 *   1. Run the MAC-address scanner sketch on the CYD receiver board and
 *      replace cydMacAddress[] below with the real 6-byte address.
 *   2. Adjust RADAR_RX_PIN / RADAR_TX_PIN if wired differently.
 *   3. Replace the dummy parse block in loop() with the actual frame-parsing
 *      algorithm for your specific radar firmware/protocol.
 * ─────────────────────────────────────────────────────────────────────────────
 */

#include <esp_now.h>
#include <WiFi.h>
#include <HardwareSerial.h>

// ── UART pins used to communicate with the 24 GHz radar module ──────────────
// Adjust if your wiring differs from the default XIAO C6 UART1 pin-out.
#define RADAR_RX_PIN 17
#define RADAR_TX_PIN 16

HardwareSerial RadarSerial(1);  // UART1

// ── MAC address of the paired CYD handheld display ─────────────────────────
// Replace with the real address found by running a scanner sketch on the CYD.
uint8_t cydMacAddress[] = {0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF};

// ── Shared data packet ──────────────────────────────────────────────────────
// This structure must match the receive-side definition on the CYD exactly.
typedef struct struct_radar_packet {
    float distance;  // Target distance in metres
    float angle;     // Target azimuth angle in degrees (relative to sensor face)
    float speed;     // Target velocity in m/s (negative = approaching)
    int   energy;    // Raw radar-cross-section energy (proxy for target mass)
} struct_radar_packet;

struct_radar_packet outboundData;
esp_now_peer_info_t peerInfo;

// ── Optional: ESP-NOW send-status callback ──────────────────────────────────
void onDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {
    if (status != ESP_NOW_SEND_SUCCESS) {
        Serial.println("[WARN] ESP-NOW delivery failed — check CYD range/power");
    }
}

// ────────────────────────────────────────────────────────────────────────────
void setup() {
    Serial.begin(115200);
    Serial.println("[KASH] Presence Monitor — starting up");

    // Initialise UART1 for the radar module.
    // Most standard 24 GHz modules run at 115200 or 256000 baud; adjust below.
    RadarSerial.begin(115200, SERIAL_8N1, RADAR_RX_PIN, RADAR_TX_PIN);

    // ESP-NOW requires the Wi-Fi stack in station mode (no AP/router needed).
    WiFi.mode(WIFI_STA);

    if (esp_now_init() != ESP_OK) {
        Serial.println("[ERROR] ESP-NOW initialisation failed — halting");
        while (true) { delay(1000); }
    }

    esp_now_register_send_cb(onDataSent);

    // Register the CYD display as a communication peer.
    memset(&peerInfo, 0, sizeof(peerInfo));
    memcpy(peerInfo.peer_addr, cydMacAddress, 6);
    peerInfo.channel = 1;
    peerInfo.encrypt = false;

    if (esp_now_add_peer(&peerInfo) != ESP_OK) {
        Serial.println("[ERROR] Failed to add CYD as ESP-NOW peer — halting");
        while (true) { delay(1000); }
    }

    Serial.println("[KASH] Presence Monitor — ready");
}

// ── Radar frame parser ───────────────────────────────────────────────────────
// Replace this stub with the real protocol for your radar firmware.
// Typical 24 GHz modules output binary frames with a header, payload, and
// checksum.  Parse those bytes into the four outboundData fields.
//
// Returns true when a complete, valid frame has been parsed into outboundData.
bool parseRadarFrame() {
    // TODO: implement your radar's protocol here.
    //
    // Example approach for a generic binary-framed protocol:
    //   1. Read bytes into a ring-buffer.
    //   2. Scan for the start-of-frame magic bytes.
    //   3. Extract payload fields (little-endian floats / int16 typically).
    //   4. Validate checksum / length.
    //   5. Populate outboundData and return true.
    //
    // Placeholder values — remove once real parsing is in place:
    outboundData.distance = 4.2f;   // metres
    outboundData.angle    = 15.5f;  // degrees
    outboundData.speed    = 0.4f;   // m/s
    outboundData.energy   = 45;     // a.u.
    return true;
}

// ────────────────────────────────────────────────────────────────────────────
void loop() {
    // Process every available byte from the radar before sleeping.
    if (RadarSerial.available() > 0) {
        if (parseRadarFrame()) {
            // Transmit the parsed target profile to the CYD display.
            esp_err_t result = esp_now_send(
                cydMacAddress,
                (uint8_t *) &outboundData,
                sizeof(outboundData)
            );
            if (result != ESP_OK) {
                Serial.printf("[WARN] esp_now_send error: %s\n", esp_err_to_name(result));
            }
        }
    }

    // 50 ms polling gives ≈20 Hz update rate — sufficient for walking-speed
    // targets.  Lower this value for faster-moving targets if the radar
    // firmware supports a higher output rate.
    delay(50);
}
